# Copy to .env. The development server loads this file on startup.
# Never prefix provider keys with VITE_: credentials belong on the server.
ANTHROPIC_API_KEY=
# Optional: earned Dolphin dialogue via OpenRouter. New dates always begin on Haiku.
# Only the server unlocks this route after delivered mutual flirtation and earned confidence.
OPENROUTER_API_KEY=
# Set DATE_CONVERSATION_PROVIDER=aihorde for free conversation from the start.
# This mode disables paid model choices. Horde hosts can inspect/save messages; tell players.
# Alternatively set only DATE_EARNED_PROVIDER=aihorde to keep Haiku-first play.
# Horde has variable queues and no paid fallback. Blank key uses the public anonymous key.
DATE_CONVERSATION_PROVIDER=
DATE_EARNED_PROVIDER=
AI_HORDE_API_KEY=
AI_HORDE_MODEL=
AI_HORDE_TRANSPORT=native
AI_HORDE_TIMEOUT_MS=60000
# Character dialogue defaults to Anthropic; Horde can be selected below or via /model horde.
# Speech defaults to free online Edge TTS.
# edge | none | elevenlabs. ElevenLabs is used only when explicitly selected.
DATE_SPEECH_PROVIDER=edge
ELEVENLABS_API_KEY=

# Optional Microsoft Edge neural voices. Edge is online and can change or throttle;
# device speech/captions remain available. Only modest rate/pitch adjustments are
# supported here, not ElevenLabs-style acted emotions.
DATE_EDGE_VOICE_MIRA=en-US-AvaMultilingualNeural
DATE_EDGE_VOICE_JULES=en-GB-SoniaNeural
DATE_EDGE_VOICE_DEV=en-US-AndrewMultilingualNeural
DATE_EDGE_VOICE_WAITER=en-GB-RyanNeural
DATE_EDGE_VOICE_DINER=en-US-GuyNeural

# Optional licensed ElevenLabs voice IDs. Defaults are defined in content.ts.
DATE_VOICE_MIRA=
DATE_VOICE_JULES=
DATE_VOICE_DEV=
DATE_VOICE_WAITER=
DATE_VOICE_DINER=

# Initial per-dinner budget; development settings may lower or adjust it.
DATE_SESSION_LIMIT_USD=2
DATE_DAILY_LIMIT_USD=10
# These two settings apply only to explicit elevenlabs mode, never free Edge.
DATE_SPEECH_MODEL=eleven_v4_turbo
DATE_SPEECH_COST_PER_1K=0.04

# Optional explicit paid utility caps (utilities default to dry run).
DATE_CLIP_LIMIT_USD=2
DATE_EVAL_LIMIT_USD=0.50

# Optional RTC ICE servers for friend voice in Double date. The server shares these ICE settings with authenticated room members.
# Public STUN is the default; configure your relay for restrictive networks.
# DATE_ICE_SERVERS_JSON=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"...","credential":"..."}]
